{
  "name": "getter",
  "version": "2.0.0",
  "private": true,
  "description": "Discover a page's colors, fonts and images. Created by Aptelum Labs.",
  "type": "module",
  "engines": { "node": ">=24.15 <25" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:prod": "npm run build",
    "build:dev": "node scripts/build.mjs --development",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "check": "npm test && npm run build && node scripts/check-package.mjs"
  },
  "repository": { "type": "git", "url": "git+https://github.com/asbillings07/Getter.git" },
  "author": "Aptelum Labs",
  "license": "ISC",
  "dependencies": { "jszip": "3.10.1", "react": "18.2.0", "react-dom": "18.2.0" },
  "devDependencies": { "@playwright/test": "1.64.1", "esbuild": "0.28.2", "jsdom": "30.1.3" }
}
