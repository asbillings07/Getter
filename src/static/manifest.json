{
  "name": "Getter",
  "version": "2.1.0",
  "description": "Explore colors, fonts and images on the page you choose. Created by Aptelum Labs.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "webNavigation"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src https:; img-src 'self' https:"
  },
  "action": {
    "default_title": "Getter \u2014 Created by Aptelum Labs",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/CSS-Getter-Icon-16px.png",
      "32": "images/CSS-Getter-Icon-32px.png",
      "48": "images/CSS-Getter-Icon-48px.png",
      "128": "images/CSS-Getter-Icon-128px.png"
    }
  },
  "icons": {
    "16": "images/CSS-Getter-Icon-16px.png",
    "32": "images/CSS-Getter-Icon-32px.png",
    "48": "images/CSS-Getter-Icon-48px.png",
    "128": "images/CSS-Getter-Icon-128px.png"
  },
  "manifest_version": 3,
  "minimum_chrome_version": "120"
}
